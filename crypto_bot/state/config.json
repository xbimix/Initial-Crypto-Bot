{
  "enabled": true,
  "execution_mode": "paper",
  "starting_balance": 10000,

  "symbols": [
    "BTC-USD",
    "ETH-USD",
    "SOL-USD",
    "BNB-USD",
    "XRP-USD",
    "ADA-USD",
    "DOT-USD",
    "XLM-USD",
    "SUI-USD",
    "SEI-USD",
    "POLS-USD",
    "ASM-USD",
    "LCX-USD",
    "XCN-USD",
    "ARPA-USD"
  ],

  "lookback": 200,
  "min_trades": 3,

  "risk": {
    "risk_percent": 0.02,
    "max_concurrent_trades": 1,
    "cooldown_seconds": 90
  },

  "market_regime": {
    "type": "bear",
    "preferred_buy_zone": [0.05, 0.30],
    "min_z_score": -1.5
  },

  "profit_locks": {
    "first_activation": 0.02,
    "initial_lock": 0.01,
    "levels": [
      [0.04, 0.03],
      [0.05, 0.04],
      [0.06, 0.05],
      [0.08, 0.06]
    ],
    "max_negative_z_score": -3.5
  },

  "volatility_filters": {
    "min_atr": 0.0003,
    "min_atr_pct": 0.0003,
    "max_trade_jump_pct": 0.12
  },

  "market_data": {
    "history_seconds": 86400,
    "min_history_points": 8,
    "max_spread_bps": 150,
    "max_book_trade_gap_pct": 0.02,
    "trade_confirmation_limit": 100
  },

  "loop_sleep": 10,
  "log_level": "INFO"
}
